{
  "name": "cardbattle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev:server": "pnpm --filter @cardbattle/server dev",
    "dev:client": "pnpm --filter @cardbattle/client dev",
    "build": "pnpm --filter @cardbattle/client build",
    "start": "pnpm --filter @cardbattle/server start",
    "test": "pnpm --filter @cardbattle/shared test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "msgpackr-extract"]
  }
}
